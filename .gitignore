# OS
.DS_Store

# 审计数据产物（含真实公司数据：设备/人员/合同号），禁止入库，只留本地
# 原始 xlsx 已由上方 *.xlsx 忽略；这里挡住探索底稿与结果 CSV
evidence/explore/
evidence/reconcile/

# 运行工具痕迹（oh-my-openagent / workbuddy 工作目录，产物已入库，不入版本控制）
.omo/
.workbuddy/

# .claude/worktrees/ 是 git worktree 的工作目录（内含独立 .git），不属于本仓库内容。
# 不忽略的话，`git add .claude/` 会把它当"嵌入式仓库"以 gitlink 形式记入索引（2026-09-11 踩过）。
.claude/worktrees/

# .claude/skills 下的 10 个审计技能为 junction 门牌（指向仓库根同名正本，见 ADR-027）。
# junction 内容与正本完全同体，git 不识别链接会导致同一改动双份记账——正本已记账，此处免记。
# 注意：精确列举，不用通配——geb-bootstrap / geb-workflow 是原生真身目录，必须照常记账。
.claude/skills/audit-execution-assistant/
.claude/skills/audit-finding-debate/
.claude/skills/audit-interview-designer/
.claude/skills/document-organizer/
.claude/skills/internal-audit-evaluator/
.claude/skills/internal-audit-program-generator/
.claude/skills/internal-audit-report-generator/
.claude/skills/program-quality-evaluator/
.claude/skills/project-init/
.claude/skills/topic-wizard/
